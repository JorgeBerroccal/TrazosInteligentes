# Copia este archivo como .env.local y completa lo que necesites.
# Todas las variables son OPCIONALES: sin ellas el proyecto funciona en modo local.

# --- Almacenamiento persistente de leads (recomendado en Vercel) ---
# Upstash Redis (plan gratuito). Vercel las crea solas si instalas Upstash desde el Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Aviso por email de cada nuevo lead (opcional) ---
# API key de https://resend.com (plan gratuito)
RESEND_API_KEY=
# Correo que recibirá los avisos
LEADS_NOTIFY_TO=
# Remitente. Sin dominio verificado en Resend usa: onboarding@resend.dev
LEADS_NOTIFY_FROM=onboarding@resend.dev
